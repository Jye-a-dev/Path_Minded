# Monorepo Root Git Ignore

# Dependency directories
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
/coverage
**/coverage

# Environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# IDE / Editor folders
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
